{
  "name": "lectia",
  "version": "1.0.0",
  "private": true,
  "description": "Lectia: lector de libros para el celular (PDF, EPUB, Word, TXT…) con lectura rápida, minijuegos, biblioteca y respaldo.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite --host",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
